# Copy to eval-service/.env (gitignored) and fill in. Real environment variables take precedence.
OPENAI_API_KEY=sk-...

# Optional. Meridian normally sends the judge key saved in its Settings; these are the service's own fallbacks.
# ANTHROPIC_API_KEY=sk-ant-...        # a Claude judge, when the Settings modal has none
# GEMINI_API_KEY=...                  # a Gemini judge (GOOGLE_API_KEY also works)
# EVAL_ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
# EVAL_GEMINI_JUDGE_MODEL=gemini-2.5-flash
# EVAL_JUDGE_MODEL=gpt-4o-mini        # the model that judges answers
# EVAL_GENERATOR_MODEL=gpt-4o         # writes synthetic golden source text (golden/synth.py)
# EVAL_LABELER_MODEL=gpt-4.1         # blind re-labeler; must differ from the generator and the judge
# EVAL_PASS_THRESHOLD=0.6
