# Copy to .env.local (gitignored) and fill in. Every value is optional: with none set, Meridian runs on its local
# heuristic evaluator. You can also paste keys into the in-app Settings dialog instead; those win over these.

# TypeSafe (https://console.typesafe.ai/settings/keys). Without it, answers come from the local demo heuristic.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# OpenAI: the comparison backend, and the model that writes chat replies. Without it the OpenAI side is off.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# How hard OpenAI's reasoning models think before answering: minimal | low | medium | high | none (reasoning off).
# OPENAI_REASONING_EFFORT=medium

# Where the DeepEval service listens (see eval-service/README.md). The judge's own keys live in eval-service/.env.
# EVAL_SERVICE_URL=http://localhost:8008
# Shared secret between the app and the service (`npm run meridian` generates one if this is blank). Set it yourself when you
# start the two separately, or when the service is reachable from anywhere but this machine.
# EVAL_SERVICE_TOKEN=

# Used by `npm run meridian` only.
# PORT=3000
# HOST=meridian.local
# MERIDIAN_EVAL=0            # do not start the evaluation service alongside the app
# EVAL_SERVICE_PORT=8008
